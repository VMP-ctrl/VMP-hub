-- [ ESP ]
-- =========================================================================
local espFolder = nil
local espCache = {}

local function clearESP()
    for _, obj in pairs(espCache) do pcall(function() obj:Destroy() end) end
    espCache = {}
end

local function buildESP()
    clearESP()
    if not C.ESPEnabled then return end
    if not espFolder or not espFolder.Parent then
        espFolder = Instance.new("Folder")
        espFolder.Name = "VMP_ESP"
        espFolder.Parent = (gethui and gethui()) or CoreGui
    end
    local hrp = getHRP(LP)
    if not hrp then return end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and not isTeam(plr) then
            local char = plr.Character
            if char then
                local head = char:FindFirstChild("Head")
                local hum = char:FindFirstChildOfClass("Humanoid")
                if head and hum and hum.Health > 0 then
                    local d = dist(hrp, head)

                    local hl = Instance.new("Highlight")
                    hl.Adornee = char
                    hl.FillColor = C.ESPColor
                    hl.OutlineColor = C.ESPColor
                    hl.FillTransparency = 0.7
                    hl.OutlineTransparency = 0
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    hl.Parent = espFolder
                    table.insert(espCache, hl)

                    local bg = Instance.new("BillboardGui")
                    bg.Adornee = head
                    bg.Size = UDim2.new(0, 200, 0, 60)
                    bg.StudsOffset = Vector3.new(0, 3, 0)
                    bg.AlwaysOnTop = true
                    bg.Parent = espFolder

                    local y = 0
                    if C.ESPName then
                        local n = Instance.new("TextLabel")
                        n.Size = UDim2.new(1, 0, 0, 16)
                        n.Position = UDim2.new(0, 0, 0, y)
                        n.BackgroundTransparency = 1
                        n.Text = plr.Name
                        n.TextColor3 = Color3.new(1,1,1)
                        n.Font = Enum.Font.GothamBold
                        n.TextSize = 13
                        n.TextStrokeTransparency = 0.4
                        n.Parent = bg
                        y = y + 16
                    end
                    if C.ESPHealth and hum then
                        local hpFrac = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                        local hpBg = Instance.new("Frame")
                        hpBg.Size = UDim2.new(0, 100, 0, 4)
                        hpBg.Position = UDim2.new(0.5, -50, 0, y)
                        hpBg.BackgroundColor3 = Color3.new(0, 0, 0)
                        hpBg.BorderSizePixel = 0
                        hpBg.Parent = bg
                        local hpFill = Instance.new("Frame")
                        hpFill.Size = UDim2.new(hpFrac, 0, 1, 0)
                        hpFill.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
                        hpFill.BorderSizePixel = 0
                        hpFill.Parent = hpBg
                        y = y + 8
                    end
                    if C.ESPDistance then
                        local dl = Instance.new("TextLabel")
                        dl.Size = UDim2.new(1, 0, 0, 14)
                        dl.Position = UDim2.new(0, 0, 0, y)
                        dl.BackgroundTransparency = 1
                        dl.Text = string.format("%.0fm", d)
                        dl.TextColor3 = Color3.fromRGB(200, 200, 200)
                        dl.Font = Enum.Font.Gotham
                        dl.TextSize = 11
                        dl.TextStrokeTransparency = 0.5
                        dl.Parent = bg
                    end

                    table.insert(espCache, bg)
                end
            end
        end
    end
end

