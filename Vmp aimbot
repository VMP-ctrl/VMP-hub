-- [ SPEED / JUMP / NOCLIP ]
-- =========================================================================
local function applySpeed()
    local h = getHum(LP)
    if h then h.WalkSpeed = C.SpeedEnabled and C.WalkSpeed or 16 end
end
local function applyJump()
    local h = getHum(LP)
    if h then
        if h.UseJumpPower then
            h.JumpPower = C.JumpEnabled and C.JumpPower or 50
        else
            h.JumpHeight = C.JumpEnabled and (C.JumpPower/7.14) or 7.2
        end
    end
end

LP.CharacterAdded:Connect(function()
    task.wait(0.5)
    applySpeed()
    applyJump()
end)

RunService.Stepped:Connect(function()
