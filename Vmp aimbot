local holdingKey = false
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.UserInputType == C.AimbotKey then holdingKey = true end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == C.AimbotKey then holdingKey = false end
end)

local function shouldAim()
    if not C.AimbotEnabled then return false end
    if C.AimbotMode == "Toujours" then return true end
    if MOBILE then return true end
    return holdingKey
end

local function findBestTarget()
    local hrp = getHRP(LP)
    if not hrp then return nil end
    local best, bestScore = nil, math.huge
    local center = Camera.ViewportSize / 2

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and not (C.AimbotTeamCheck and isTeam(plr)) then
            local char = plr.Character
            if char then
                local part
                if C.AimbotHitbox == "Head" then
                    part = char:FindFirstChild("Head")
                elseif C.AimbotHitbox == "Torso" then
                    part = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
                else
                    part = char:FindFirstChild("HumanoidRootPart")
                end
                if part then
                    local d = dist(hrp, part)
                    if d <= C.AimbotMaxDist then
                        local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
                        if onScreen then
                            local dx = screenPos.X - center.X
                            local dy = screenPos.Y - center.Y
                            local fovDist = math.sqrt(dx*dx + dy*dy)
                            if fovDist <= C.AimbotFOV then
                                if visible(part) and fovDist < bestScore then
                                    bestScore = fovDist
                                    best = { plr = plr, part = part }
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return best
end

